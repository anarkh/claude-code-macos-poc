# Candidate for Ubuntu 24.04, AppArmor ABI 4.0, system Python 3.12 only.
# Root-owned source. No ux, pix/cix fallback, complain or default_allow.
# This fixture does NOT cover native SDK/CLI, Bash, MCP or project entrypoints.
abi <abi/4.0>,

profile claude-poc-manager flags=(enforce) {
  /usr/bin/python3{,.12} ix,
  /usr/bin/aa-exec ix,
  /usr/sbin/apparmor_parser ix,
  /usr/bin/{python3.12,aa-exec} mr,
  /usr/sbin/apparmor_parser mr,
  # Importlib lists the stdlib root; /** does not match the root directory.
  /usr/lib/python3.12/ r,
  /usr/lib/python3.12/** mr,
  /usr/lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /usr/lib/locale/** r,
  /etc/ld.so.cache r,
  /etc/apparmor.d/abi/4.0 r,
  /etc/apparmor/parser.conf r,
  /opt/claude-code-poc/guest/ r,
  /opt/claude-code-poc/guest/** r,
  /etc/claude-code-poc/isolated-test-vm.json r,
  /dev/{null,urandom,random} rw,
  /proc/ r,
  /proc/version r,
  /proc/{self,thread-self}/** r,
  /proc/[0-9]*/{stat,status,cgroup,mountinfo} r,
  /proc/[0-9]*/attr/{current,exec} rw,
  /proc/sys/kernel/yama/ptrace_scope r,
  /sys/module/apparmor/parameters/enabled r,
  /sys/kernel/security/apparmor/profiles r,
  /sys/kernel/security/lsm r,
  /sys/fs/cgroup/ r,
  /sys/fs/cgroup/cgroup.controllers r,
  /sys/fs/cgroup/claude-code-poc/{,**} rw,
  /var/lib/claude-code-poc/{,**} rwk,
  /run/user/ r,
  /run/user/29999/ r,
  capability setuid,
  capability setgid,
  capability chown,
  capability dac_override,
  capability fowner,
  change_profile -> claude-poc-control,
  change_profile -> claude-poc-work,
  ptrace (read, trace) peer=claude-poc-control,
  ptrace (read, trace) peer=claude-poc-work,
  signal (send, receive) peer=claude-poc-control,
  signal (send, receive) peer=claude-poc-work,
  signal (receive) peer=unconfined,
}

profile claude-poc-control flags=(enforce) {
  /usr/bin/python3{,.12} ix,
  /usr/bin/aa-exec ix,
  /usr/bin/{python3.12,aa-exec} mr,
  # Importlib lists the stdlib root; /** does not match the root directory.
  /usr/lib/python3.12/ r,
  /usr/lib/python3.12/** mr,
  /usr/lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /usr/lib/locale/** r,
  /etc/ld.so.cache r,
  /opt/claude-code-poc/guest/{,*.py} r,
  /dev/{null,urandom,random} rw,
  /proc/{self,thread-self}/** r,
  /proc/[0-9]*/{stat,status,cgroup} r,
  /proc/[0-9]*/attr/{current,exec} rw,
  /var/lib/claude-code-poc/current/control-sentinel rw,
  network unix stream,
  change_profile -> claude-poc-work,
  deny capability sys_ptrace,
  deny ptrace (readby, tracedby) peer=claude-poc-work,
  ptrace (readby, tracedby) peer=claude-poc-manager,
  signal (receive) peer=claude-poc-manager,
  signal (send, receive) peer=claude-poc-work,
}

profile claude-poc-work flags=(enforce) {
  /usr/bin/python3{,.12} ix,
  /usr/bin/python3.12 mr,
  # Importlib lists the stdlib root; /** does not match the root directory.
  /usr/lib/python3.12/ r,
  /usr/lib/python3.12/** mr,
  /usr/lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /usr/lib/locale/** r,
  /etc/ld.so.cache r,
  /opt/claude-code-poc/guest/{,*.py} r,
  /dev/{null,urandom,random} rw,
  /dev/fd/[0-9]* rw,
  /proc/{self,thread-self}/** r,
  /proc/[0-9]*/{stat,status,cgroup} r,
  /proc/[0-9]*/attr/current r,
  owner /proc/[0-9]*/fd/{,[0-9]*} r,
  /var/lib/claude-code-poc/current/target.json r,
  /var/lib/claude-code-poc/current/work-{identities,writes}.jsonl rw,
  deny /var/lib/claude-code-poc/current/control-sentinel rw,
  deny /proc/[0-9]*/mem rw,
  deny /sys/fs/cgroup/** w,
  deny /run/** rw,
  deny /var/run/** rw,
  deny /var/spool/** rw,
  deny capability,
  deny ptrace (read, trace) peer=claude-poc-control,
  ptrace (readby, tracedby) peer=claude-poc-manager,
  signal (receive) peer=claude-poc-manager,
  signal (receive) peer=claude-poc-control,
  signal (send, receive) peer=claude-poc-work,
}
