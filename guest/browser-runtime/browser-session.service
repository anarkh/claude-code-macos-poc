[Unit]
Description=Isolated graphical Firefox session
After=systemd-user-sessions.service browser-proxy.service browser-profile.service browser-config.service
Requires=browser-profile.service browser-config.service
Wants=browser-proxy.service

[Service]
Environment=LANG=ja_JP.UTF-8
Environment=LC_ALL=ja_JP.UTF-8
Environment=TZ=Asia/Tokyo
ExecStartPre=/usr/bin/install -d -m 0700 -o browser -g browser /run/browser-session
ExecStart=/usr/bin/xinit /opt/browser/session-launch.sh -- /usr/lib/xorg/Xorg :0 vt1 -keeptty -nolisten tcp
ExecStop=/usr/bin/python3 /opt/browser/stop-session.py
Restart=always
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=no
TimeoutStopSec=45
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
