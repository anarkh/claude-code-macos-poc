[Unit]
Description=Browser loopback to host vsock byte bridge
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 /opt/browser/proxy.py
DynamicUser=yes
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_VSOCK AF_UNIX
CapabilityBoundingSet=
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
