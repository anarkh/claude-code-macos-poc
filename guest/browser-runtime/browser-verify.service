[Unit]
Description=Build-only no-NIC graphical verification
ConditionKernelCommandLine=browser.verify=1
After=browser-ready.service
Requires=browser-ready.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/browser/diagnostic.py
ExecStartPost=/bin/sh -c 'echo BROWSER_ACPI_STOP_READY > /dev/hvc0'
Environment=LANG=ja_JP.UTF-8
Environment=LC_ALL=ja_JP.UTF-8
StandardOutput=tty
TTYPath=/dev/hvc0
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
