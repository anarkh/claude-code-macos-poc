# Candidate Ubuntu 24.04 ABI 4.0: native SDK, CLI, and Bash have separate domains.
# Every executable transition is ix or mandatory Px. No unconfined fallback.
abi <abi/4.0>,

profile claude-native-manager flags=(enforce) {
  /usr/bin/python3{,.12} ix,
  /usr/bin/aa-exec ix,
  /usr/bin/{python3.12,aa-exec} mr,
  /usr/lib/python3.12/{,**} mr,
  /usr/lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /usr/lib/locale/** r,
  /etc/locale.alias r,
  /usr/share/zoneinfo/Asia/Tokyo r,
  /etc/ssl/openssl.cnf r,
  /etc/ld.so.cache r,
  /opt/claude-code-poc/native/{,**} r,
  /opt/claude-code-poc/node r,
  /opt/claude-code-poc/native-runtime/{,**} r,
  /etc/claude-code-poc/isolated-test-vm.json r,
  /etc/claude-code-poc/{relay.json,egress-rules.json} r,
  /opt/claude-code-poc/relay/{,**} r,
  /proc/{self,thread-self}/{,**} r,
  /proc/[0-9]*/{stat,status,cgroup,maps,cmdline,mountinfo} r,
  /proc/[0-9]*/fd/{,[0-9]*} r,
  /proc/[0-9]*/attr/{current,exec} rw,
  /proc/sys/kernel/yama/ptrace_scope r,
  /sys/class/net/{,**} r,
  /sys/kernel/security/{lsm,apparmor/profiles} r,
  /sys/module/apparmor/parameters/enabled r,
  /sys/fs/cgroup/{,cgroup.controllers} r,
  /sys/fs/cgroup/claude-code-native-poc/{,**} rw,
  /var/lib/claude-code-native-poc/{,**} rwk,
  /dev/{null,urandom,random} rw,
  /dev/hvc0 rw,
  capability setuid,
  capability setgid,
  capability chown,
  capability dac_override,
  capability dac_read_search,
  # Root broker passively inventories its own managed CLI/controller FDs.
  capability sys_ptrace,
  capability fowner,
  change_profile -> claude-native-controller,
  change_profile -> claude-native-relay,
  ptrace (read) peer=claude-native-relay,
  ptrace (read) peer=claude-native-controller,
  ptrace (read) peer=claude-native-cli,
  ptrace (read) peer=claude-native-work,
  signal (send, receive) peer=claude-native-controller,
  signal (send, receive) peer=claude-native-cli,
  signal (send, receive) peer=claude-native-work,
  signal (send, receive) peer=claude-native-relay,
  signal (receive) peer=unconfined,
}

profile claude-native-relay flags=(enforce) {
  /usr/bin/python3{,.12} ix,
  /usr/bin/python3.12 mr,
  /usr/lib/python3.12/{,**} mr,
  /usr/lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /etc/{ld.so.cache,localtime} r,
  /etc/locale.alias r,
  /etc/ssl/openssl.cnf r,
  /usr/share/zoneinfo/** r,
  /usr/lib/locale/** r,
  /opt/claude-code-poc/relay/relay.py r,
  /etc/claude-code-poc/isolated-test-vm.json r,
  /etc/claude-code-poc/relay.json r,
  /etc/claude-code-poc/relay/{ca.pem,client.pem,client.key} r,
  /proc/{self,thread-self}/{,**} r,
  /proc/[0-9]*/{stat,status,cgroup,mountinfo} r,
  /proc/[0-9]*/attr/current r,
  /sys/class/net/{,**} r,
  /dev/{null,urandom,random} rw,
  /var/lib/claude-code-native-poc/relay{.log,-evidence.json,-evidence.json.tmp,-ready.json} rwk,
  network inet stream,
  network vsock stream,
  ptrace (readby) peer=claude-native-manager,
  signal (receive) peer=claude-native-manager,
  signal (send, receive) peer=claude-native-relay,
  deny capability,
  deny /var/lib/claude-code-native-poc/current/{,**} rwklx,
}

profile claude-native-controller flags=(enforce) {
  /opt/claude-code-poc/node ix,
  /opt/claude-code-poc/node mr,
  /opt/claude-code-poc/native-runtime/sdk/{,**} r,
  /opt/claude-code-poc/native-runtime/sdk/node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64/claude Px -> claude-native-cli,
  /usr/lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /etc/{ld.so.cache,resolv.conf,hosts,nsswitch.conf,localtime} r,
  /etc/ssl/openssl.cnf r,
  /usr/share/zoneinfo/** r,
  /usr/lib/locale/** r,
  /proc/{self,thread-self}/{,**} r,
  /proc/[0-9]*/{stat,status,cgroup} r,
  owner /proc/[0-9]*/maps r,
  /proc/{version,version_signature,meminfo,stat} r,
  /sys/devices/system/cpu/online r,
  /run/systemd/resolve/stub-resolv.conf r,
  /proc/[0-9]*/attr/current r,
  /sys/class/net/{,**} r,
  /dev/{null,urandom,random} rw,
  /var/lib/claude-code-native-poc/current/controller/{,**} rwk,
  /var/lib/claude-code-native-poc/current/{targets.json,target-ready.json} r,
  /var/lib/claude-code-native-poc/current/{home,tmp,work}/{,**} rwk,
  network inet stream,
  network unix stream,
  deny capability sys_ptrace,
  deny ptrace (readby, tracedby) peer=claude-native-work,
  ptrace (readby, tracedby) peer=claude-native-manager,
  signal (send, receive) peer=claude-native-cli,
  signal (receive) peer=claude-native-manager,
}

profile claude-native-cli flags=(enforce) {
  /opt/claude-code-poc/native-runtime/sdk/node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64/claude mr,
  /usr/lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /etc/{ld.so.cache,resolv.conf,hosts,nsswitch.conf,passwd,group,localtime} r,
  /usr/share/zoneinfo/** r,
  /usr/lib/locale/** r,
  /usr/bin/bash Px -> claude-native-work,
  /bin/bash Px -> claude-native-work,
  /usr/bin/dash Px -> claude-native-work,
  /bin/dash Px -> claude-native-work,
  /usr/bin/sh Px -> claude-native-work,
  /bin/sh Px -> claude-native-work,
  /proc/{self,thread-self}/{,**} r,
  /proc/[0-9]*/{stat,status,cgroup} r,
  owner /proc/[0-9]*/maps r,
  /proc/sys/vm/{overcommit_memory,mmap_min_addr} r,
  /sys/kernel/mm/transparent_hugepage/enabled r,
  owner /proc/[0-9]*/statm r,
  /proc/{stat,version} r,
  /sys/devices/system/cpu/online r,
  /sys/fs/cgroup/claude-code-native-poc/{memory.max,memory.high} r,
  /proc/[0-9]*/attr/current r,
  /dev/{null,urandom,random,tty} rw,
  /var/lib/claude-code-native-poc/current/{home,tmp,work}/{,**} rwk,
  /var/lib/claude-code-native-poc/current/targets.json r,
  deny /var/lib/claude-code-native-poc/current/controller/{,**} rwklx,
  deny /opt/claude-code-poc/native-runtime/sdk/{run-native-admission.mjs,origin-contract.mjs} rwklx,
  network inet stream,
  network unix stream,
  deny capability,
  deny ptrace (read, trace) peer=claude-native-controller,
  deny ptrace (readby, tracedby) peer=claude-native-work,
  ptrace (readby, tracedby) peer=claude-native-manager,
  signal (send, receive) peer=claude-native-controller,
  signal (send, receive) peer=claude-native-work,
  signal (receive) peer=claude-native-manager,
}

profile claude-native-work flags=(enforce) {
  /usr/bin/{bash,dash,sh,env,python3,python3.12} ix,
  /bin/{bash,dash,sh} ix,
  /usr/bin/{bash,dash,env,python3.12} mr,
  /usr/lib/python3.12/{,**} mr,
  /usr/lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /lib/{aarch64-linux-gnu,x86_64-linux-gnu}/** mr,
  /usr/lib/locale/** r,
  /usr/share/zoneinfo/** r,
  /etc/{ld.so.cache,localtime,passwd,group} r,
  /opt/claude-code-poc/native/work_fixture.py r,
  /proc/{self,thread-self}/{,**} r,
  /proc/[0-9]*/{stat,status,cgroup} r,
  /proc/[0-9]*/attr/current r,
  owner /proc/[0-9]*/fd/{,[0-9]*} r,
  /dev/{null,urandom,random,tty} rw,
  /var/lib/claude-code-native-poc/current/targets.json r,
  /var/lib/claude-code-native-poc/current/work/{,**} rwk,
  /var/lib/claude-code-native-poc/current/tmp/claude-*-cwd rw,
  /var/lib/claude-code-native-poc/current/tmp/claude-29998/{,**} rwk,
  # Existing unnamed tool-data sockets may talk to the CLI, never the SDK.
  # No create/bind/connect/listen permission or access to named service sockets.
  unix (send, receive) type=stream addr=none peer=(label=claude-native-cli),
  deny /var/lib/claude-code-native-poc/current/controller/{,**} rwklx,
  deny /var/lib/claude-code-native-poc/current/home/{,**} rwklx,
  deny /opt/claude-code-poc/node x,
  deny /opt/claude-code-poc/native-runtime/{,**} rwklx,
  deny /proc/[0-9]*/mem rw,
  deny /sys/fs/cgroup/** w,
  deny /run/{,**} rwklx,
  deny /var/run/{,**} rwklx,
  deny /var/spool/{,**} rwklx,
  deny capability,
  deny ptrace (read, trace) peer=claude-native-controller,
  deny ptrace (read, trace) peer=claude-native-cli,
  ptrace (readby, tracedby) peer=claude-native-manager,
  signal (receive) peer=claude-native-manager,
  signal (receive) peer=claude-native-cli,
  signal (send, receive) peer=claude-native-work,
}
